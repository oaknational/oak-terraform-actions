{
  "name": "oak-terraform-linter",
  "version": "0.1.0",
  "description": "Custom rule-based linter for Terraform code",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/oaknational/oak-terraform-linter"
  },
  "keywords": ["terraform", "linter", "validation", "rules"],
  "author": "Oak National Academy",
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "lint": "eslint src tests",
    "format": "prettier --write src tests",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "linter": "ts-node src/index.ts",
    "parse": "ts-node src/commands/parse/parse.ts"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.9.0",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "@cdktf/hcl2json": "^0.15.0",
    "chalk": "^4.1.2",
    "yargs": "^17.7.0"
  }
}
